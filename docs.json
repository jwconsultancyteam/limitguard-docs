{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LimitGuard",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#10B981",
    "light": "#34D399",
    "dark": "#059669"
  },
  "navbar": {
    "links": [
      {
        "label": "limitguard.ai",
        "href": "https://limitguard.ai"
      },
      {
        "label": "API Status",
        "href": "https://api.limitguard.ai/health"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://api.limitguard.ai/v1/keys/create"
    }
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "API Reference",
        "icon": "code",
        "href": "/api-reference/introduction"
      },
      {
        "anchor": "GitHub",
        "icon": "github",
        "href": "https://github.com/jwconsultancyteam/limitguard-docs"
      }
    ],
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "sandbox"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "pricing",
              "x402-protocol",
              "discovery"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/errors",
              "guides/rate-limits",
              "guides/webhooks",
              "guides/trust-architecture",
              "guides/ai-agent-integration"
            ]
          },
          {
            "group": "Post-mortems",
            "pages": [
              "postmortems/2026-09-downtime-log",
              "postmortems/2026-09-langfuse-event-loop"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/2026-09-08",
              "changelog/2026-09-07",
              "changelog/2026-09-05",
              "changelog/2026-02-20"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "baseUrl": "https://api.limitguard.ai",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "search": {
    "prompt": "Search LimitGuard docs..."
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jwconsultancyteam/limitguard-docs",
      "website": "https://limitguard.ai"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "LimitGuard",
      "og:description": "LimitGuard API docs: KYB, sanctions and PEP screening, Dutch and Belgian company registry checks and entity trust scores for AI agents, via x402 pay-per-call, API keys or MCP."
    }
  }
}
